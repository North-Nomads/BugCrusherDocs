{
  "metadata": [
    {
      "src": [
        {
          "files": ["**/*.cs"],
          "src": "../source/Assets/_Project/Scripts",
          "exclude": [
            "**/Editor/**",
            "**/Tests/**"
          ]
        }
      ],
      "dest": "api",
      "filter": "filterConfig.yml",
      "disableGitFeatures": false,
	  "allowCompilationErrors": true
    }
  ],
  "build": {
    "content": [
      {
        "files": ["api/**.yml", "api/index.md"]
      },
      {
        "files": ["articles/**.md", "articles/**/toc.yml", "toc.yml", "*.md"]
      }
    ],
    "resource": [
      {
        "files": ["images/**"]
      }
    ],
    "dest": "_site",
    "globalMetadata": {
      "_appTitle": "BugCrusher Documentation",
      "_appName": "BugCrusher",
      "_appFooter": "BugCrusher API Documentation",
      "_enableSearch": true
    },
    "template": ["default", "modern"],
    "postProcessors": ["ExtractSearchIndex"],
    "keepFileLink": false,
    "disableGitFeatures": false,
    "xref": [
      "https://normanderwan.github.io/UnityXrefMaps/2022.3/xrefmap.yml"
    ]
  }
}